o?"><bpmn:incoming>F9</bpmn:incoming><bpmn:outgoing>F10</bpmn:outgoing><bpmn:outgoing>F12</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="Cancel" name="Cancelar solicitação"><bpmn:incoming>F10</bpmn:incoming><bpmn:outgoing>F11</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="CancelEnd" name="Solicitação cancelada"><bpmn:incoming>F11</bpmn:incoming></bpmn:endEvent><bpmn:serviceTask id="Authorize" name="Registrar autorização e encaminhar à equipe"><bpmn:incoming>F12</bpmn:incoming><bpmn:outgoing>F13</bpmn:outgoing></bpmn:serviceTask><bpmn:callActivity id="Safety" name="Inspeção de Segurança dos Equipamentos" calledElement="SafetyProcess"><bpmn:incoming>F13</bpmn:incoming><bpmn:outgoing>F14</bpmn:outgoing></bpmn:callActivity><bpmn:exclusiveGateway id="Correct" name="Protótipo correto?"><bpmn:incoming>F15</bpmn:incoming><bpmn:outgoing>F16</bpmn:outgoing><bpmn:outgoing>F22</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="Resources" name="Verificar material e tempo para nova tentativa"><bpmn:incoming>F16</bpmn:incoming><bpmn:outgoing>F17</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="Retry" name="Nova tentativa possível?"><bpmn:incoming>F17</bpmn:incoming><bpmn:outgoing>F18</bpmn:outgoing><bpmn:outgoing>F19</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="Failed" name="Encerrar como não concluída"><bpmn:incoming>F19</bpmn:incoming><bpmn:outgoing>F20</bpmn:outgoing></bpmn:serviceTask><bpmn:sendTask id="FailureNotice" name="Notificar fabricação não concluída"><bpmn:incoming>F20</bpmn:incoming><bpmn:outgoing>F21</bpmn:outgoing></bpmn:sendTask><bpmn:endEvent id="FailureEnd" name="Solicitação não concluída"><bpmn:incoming>F21</bpmn:incoming></bpmn:endEvent><bpmn:serviceTask id="Complete" name="Registrar fabricação concluída"><bpmn:incoming>F22</bpmn:incoming><bpmn:outgoing>F23</bpmn:outgoing></bpmn:serviceTask><bpmn:sendTask id="Ready" name="Notificar protótipo disponível para retirada"><bpmn:incoming>F23</bpmn:incoming><bpmn:ou